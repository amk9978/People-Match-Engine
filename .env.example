# Optional. Without one the engine scores complementarity from embeddings
# instead of asking a model. See COMPLEMENTARITY_SCORER.
OPENAI_API_KEY=

# Optional. Without a reachable Redis the engine caches in memory for the
# lifetime of the process.
REDIS_URL=redis://localhost:6379/0

# Optional. A YAML file naming the columns to score. Omitted, the engine reads
# the columns off the CSV. See presets/vendor_six_column.yaml.
FEATURE_MAPPING_PATH=

MIN_DENSITY=0.1
MAX_FEATURES=12

# auto picks the model when a key is set and embeddings otherwise.
COMPLEMENTARITY_SCORER=auto

LLM_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120.0
COMPLEMENTARITY_MAX_COMPLETION_TOKENS=8000

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
